page {
  min-height: 100%;
  background: #f5f3ec;
  color: #20302c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button {
  box-sizing: border-box;
  min-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
}

.hero {
  margin-bottom: 30rpx;
}

.eyebrow {
  color: #247463;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  margin: 12rpx 0 10rpx;
  color: #172622;
  font-size: 52rpx;
  font-weight: 760;
  line-height: 1.18;
}

.subtitle,
.muted {
  color: #64716d;
  font-size: 27rpx;
  line-height: 1.65;
}

.trust-pill {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #b8d2ca;
  border-radius: 999rpx;
  background: #eaf3ef;
  color: #245c50;
  font-size: 23rpx;
  font-weight: 650;
}

.section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #1d302b;
  font-size: 34rpx;
  font-weight: 730;
}

.card {
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #d8ddd8;
  border-radius: 28rpx;
  background: #fffefa;
  box-shadow: 0 10rpx 30rpx rgba(50, 65, 59, 0.06);
}

.card-title {
  color: #1a2d28;
  font-size: 32rpx;
  font-weight: 720;
}

.card-copy {
  margin-top: 8rpx;
  color: #65716d;
  font-size: 25rpx;
  line-height: 1.55;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.primary-button {
  background: #247463;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #bfc9c4;
  background: #ffffff;
  color: #2d4d45;
}

.danger-button {
  border: 1rpx solid #dcbab4;
  background: #fff7f5;
  color: #98453b;
}

.small-button {
  min-height: 70rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.button-stack button,
.button-row button {
  margin-top: 16rpx;
}

.button-row {
  display: flex;
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.button-row button {
  flex: 1;
  margin-left: 8rpx;
  margin-right: 8rpx;
}

.notice {
  margin: 18rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff4d8;
  color: #78591e;
  font-size: 25rpx;
  line-height: 1.55;
}

.error {
  margin: 18rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e4b6af;
  border-radius: 20rpx;
  background: #fff3f1;
  color: #8d3c34;
  font-size: 25rpx;
}

.empty {
  padding: 46rpx 28rpx;
  border: 1rpx dashed #c8d0cc;
  border-radius: 24rpx;
  color: #68736f;
  text-align: center;
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #334b45;
  font-size: 25rpx;
  font-weight: 650;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #cbd3cf;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1f312d;
  font-size: 28rpx;
}

.textarea {
  min-height: 160rpx;
}

.loading {
  padding: 100rpx 20rpx;
  color: #66736e;
  text-align: center;
}

.link-button {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-button {
  min-height: 64rpx;
  padding: 0 12rpx;
  background: transparent;
  color: #247463;
  font-size: 24rpx;
}

.badge {
  display: inline-block;
  margin-right: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf3ef;
  color: #245c50;
  font-size: 21rpx;
  font-weight: 680;
}

.danger-note {
  color: #98453b;
  font-size: 24rpx;
  line-height: 1.55;
}

.inline-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -6rpx -4rpx;
}

.inline-actions button {
  flex: 1 1 180rpx;
  margin: 8rpx 6rpx;
}
