page {
  min-height: 100%;
  background: #f7f7f3;
  color: #17201e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 400;
}

button {
  display: flex;
  box-sizing: border-box;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
}

button::after {
  border: 0;
}

button[disabled] {
  color: #8f9895;
  opacity: 1;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx 96rpx;
}

.page-with-dock {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.hero {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #247463;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.title {
  margin: 8rpx 0;
  color: #17201e;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.22;
}

.subtitle,
.muted {
  color: #66716e;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.55;
}

.muted {
  font-size: 23rpx;
  line-height: 1.45;
}

.trust-pill {
  display: block;
  margin-top: 12rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #66716e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.45;
}

.section {
  margin-top: 32rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  color: #17201e;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card {
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #dde3df;
  border-radius: 24rpx;
  background: #ffffff;
}

.card-title {
  color: #17201e;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.card-copy {
  margin-top: 6rpx;
  color: #66716e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.45;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.primary-button {
  background: #247463;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #c3ccc8;
  background: #ffffff;
  color: #2d4d45;
}

.danger-button {
  border: 1rpx solid #dfbbb5;
  background: #fff2ed;
  color: #98453b;
}

.small-button {
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.button-stack button,
.button-row button {
  margin-top: 12rpx;
}

.button-row {
  display: flex;
  margin-left: -6rpx;
  margin-right: -6rpx;
}

.button-row button {
  flex: 1;
  margin-left: 6rpx;
  margin-right: 6rpx;
}

.notice {
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fff0d5;
  color: #78591e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.55;
}

.error {
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4b6af;
  border-radius: 20rpx;
  background: #fff2ed;
  color: #8d3c34;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.55;
}

.empty {
  padding: 40rpx 24rpx;
  border: 1rpx dashed #c8d0cc;
  border-radius: 24rpx;
  color: #66716e;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: center;
}

.field {
  margin-top: 18rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  color: #334b45;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.45;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #cbd3cf;
  border-radius: 20rpx;
  background: #ffffff;
  color: #17201e;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.55;
}

.textarea {
  min-height: 160rpx;
}

.loading {
  padding: 96rpx 20rpx;
  color: #66716e;
  text-align: center;
}

.link-button {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-button {
  min-height: 88rpx;
  padding: 0 12rpx;
  border: 0;
  background: transparent;
  color: #247463;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.badge {
  display: inline-flex;
  min-height: 34rpx;
  align-items: center;
  margin-right: 8rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #e7f1ed;
  color: #245c50;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.danger-note {
  color: #98453b;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.55;
}

.inline-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -5rpx -4rpx;
}

.inline-actions button {
  flex: 1 1 180rpx;
  margin: 6rpx 5rpx;
}

.list-surface {
  overflow: hidden;
  border: 1rpx solid #dde3df;
  border-radius: 24rpx;
  background: #ffffff;
}

.list-row {
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #e5e9e6;
}

.list-row:last-child {
  border-bottom: 0;
}

.list-row-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.row-content {
  min-width: 0;
  flex: 1;
}

.row-title {
  color: #17201e;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.row-copy {
  margin-top: 6rpx;
  color: #66716e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.45;
}

.row-meta {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #66716e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.45;
  white-space: nowrap;
}

.soft-surface {
  border-color: #d7e2dd;
  background: #f0f4f1;
}

.bottom-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dde3df;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(23, 32, 30, 0.06);
}

.bottom-dock button {
  min-width: 0;
  flex: 1;
  margin: 0 6rpx;
}
