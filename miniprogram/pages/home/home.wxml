<view class="page">
  <view class="hero">
    <text class="eyebrow">今天的记忆入口</text>
    <view class="title">今天，有什么要确认的？</view>
    <view class="subtitle">选择场景，直接开始。每一次检查都只记录在当前设备。</view>
    <view class="trust-pill">仅存本机 · 无账号 · 核心离线可用</view>
  </view>

  <view class="hero-actions">
    <button class="primary-button" bindtap="openSearch">搜索场景</button>
    <button class="secondary-button" bindtap="createTemplate">新建模板</button>
  </view>

  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在读取本地清单…</view>

  <block wx:else>
    <view class="quick-nav">
      <button class="secondary-button small-button" bindtap="openPlans">计划</button>
      <button class="secondary-button small-button" bindtap="openHistory">历史</button>
      <button class="secondary-button small-button" bindtap="openData">数据</button>
    </view>

    <view wx:if="{{continueRun}}" class="section">
      <view class="section-heading">
        <view>
          <view class="section-kicker">最优先</view>
          <text class="section-title">继续检查</text>
        </view>
      </view>
      <view class="card continue-card" bindtap="openRun">
        <view class="row-between">
          <view class="continue-copy">
            <view class="card-title">{{continueRun.title}}</view>
            <view class="card-copy">{{continueRun.uncheckedCount}} 项待处理 · 关键 {{continueRun.uncheckedKeyCount}} 项</view>
          </view>
          <button class="primary-button small-button" catchtap="openRun">继续</button>
        </view>
      </view>
      <button wx:if="{{moreRunCount}}" class="text-button more-link" bindtap="openMoreRuns">另有 {{moreRunCount}} 次进行中的检查 · 查看全部</button>
    </view>

    <view wx:if="{{pendingPlans.length}}" class="section">
      <view class="section-heading">
        <view>
          <view class="section-kicker">最多显示三项</view>
          <text class="section-title">接下来</text>
        </view>
        <button class="text-button" bindtap="openPlans">全部计划</button>
      </view>
      <view wx:for="{{pendingPlans}}" wx:key="plannedCheckId" class="card plan-card">
        <view class="plan-copy">
          <view class="card-title">{{item.title}}</view>
          <view class="plan-when">{{item.when}}</view>
        </view>
        <button class="secondary-button small-button" data-plan-id="{{item.plannedCheckId}}" bindtap="startPlan" loading="{{busy}}">开始</button>
      </view>
    </view>

    <view wx:if="{{quickTemplates.length}}" class="section">
      <view class="section-heading">
        <view>
          <view class="section-kicker">当前设备</view>
          <text class="section-title">我的常用</text>
        </view>
        <button class="text-button" bindtap="openTemplates">管理</button>
      </view>
      <view class="quick-template-grid">
        <button wx:for="{{quickTemplates}}" wx:key="sourceId" class="quick-template" data-template-id="{{item.sourceId}}" bindtap="startTemplate" loading="{{busy}}">
          <text class="quick-kind">{{item.kind}}</text>
          <text class="quick-title">{{item.title}}</text>
        </button>
      </view>
    </view>

    <view class="section">
      <view class="section-heading">
        <view>
          <view class="section-kicker">7 个精选场景</view>
          <text class="section-title">官方精选</text>
        </view>
        <button class="text-button" bindtap="openTemplates">全部 13 个</button>
      </view>
      <view wx:for="{{featuredTemplates}}" wx:key="sourceId" class="card template-card">
        <view class="row-between">
          <text class="badge">{{item.kind}}</text>
          <text class="muted">{{item.itemCount}} 项</text>
        </view>
        <view class="card-title template-title" data-template-id="{{item.sourceId}}" bindtap="openTemplate">{{item.title}}</view>
        <view class="card-copy">{{item.applicability}}</view>
        <view class="button-row">
          <button class="primary-button small-button" data-template-id="{{item.sourceId}}" bindtap="startTemplate" loading="{{busy}}">直接开始</button>
          <button class="secondary-button small-button" data-template-id="{{item.sourceId}}" bindtap="openTemplate">详情</button>
        </view>
      </view>
    </view>
  </block>
</view>
