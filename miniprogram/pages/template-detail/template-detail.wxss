.detail-page {
  padding-top: 20rpx;
}

.detail-hero {
  margin-bottom: 18rpx;
}

.governance-card {
  padding: 22rpx;
  border-color: #b9d2ca;
  background: #f8fbf9;
}

.governance-actions button {
  min-width: 190rpx;
}

.detail-group {
  margin-top: 20rpx;
}

.detail-group:first-child {
  margin-top: 0;
}

.group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 10rpx;
}

.group-title {
  color: #247463;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.group-count {
  color: #66716e;
  font-size: 22rpx;
  line-height: 1.45;
}

.detail-list {
  border-radius: 24rpx;
}

.detail-item {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.detail-item-title {
  display: flex;
  min-width: 0;
  align-items: center;
  color: #233631;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.detail-title-text {
  min-width: 0;
}

.key-dot {
  display: inline-flex;
  min-height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  margin-right: 10rpx;
  padding: 3rpx 9rpx;
  border-radius: 9rpx;
  background: #fff0d5;
  color: #8a5b0b;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.item-copy {
  margin-top: 6rpx;
  color: #66716e;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-dock button:first-child {
  margin-left: 0;
}

.detail-dock button:last-child {
  margin-right: 0;
}
