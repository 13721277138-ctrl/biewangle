.more-runs-page {
  padding-top: 20rpx;
}

.compact-hero {
  margin-bottom: 18rpx;
}

.run-row {
  border-left: 6rpx solid #c8d0cc;
}

.run-row.prioritized {
  border-left-color: #247463;
  background: #f0f4f1;
}

.run-badges {
  margin-bottom: 8rpx;
}

.stale-badge {
  background: #fff0d5;
  color: #865d18;
}

.progress-line {
  margin-top: 6rpx;
  color: #247463;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}

.continue-button {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty-action {
  margin-top: 18rpx;
}
