.run-card {
  border-left: 8rpx solid #c1cbc6;
}

.run-card.prioritized {
  border-left-color: #247463;
  background: #f2f9f5;
}

.stale-badge {
  background: #fff0d5;
  color: #865d18;
}

.run-title {
  margin-top: 16rpx;
}

.progress-line {
  margin-top: 14rpx;
  color: #247463;
  font-size: 28rpx;
  font-weight: 700;
}

.continue-button,
.empty-action {
  margin-top: 20rpx;
}
