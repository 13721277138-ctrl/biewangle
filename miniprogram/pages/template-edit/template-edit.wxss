.template-edit-page {
  padding-top: 20rpx;
}

.compact-hero {
  margin-bottom: 18rpx;
}

.preview-surface {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #b9d2ca;
  border-radius: 24rpx;
  background: #f0f4f1;
}

.preview-icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: #247463;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.preview-copy {
  min-width: 0;
  flex: 1;
}

.theme-ocean .preview-icon { background: #346d86; }
.theme-clay .preview-icon { background: #9a604d; }
.theme-plum .preview-icon { background: #765773; }
.theme-graphite .preview-icon { background: #4c5754; }

.editor-surface {
  margin-top: 24rpx;
  padding-top: 2rpx;
  border-top: 1rpx solid #dde3df;
}

.first-field {
  margin-top: 20rpx;
}

.items-textarea {
  min-height: 400rpx;
}

.field-help {
  margin-top: 8rpx;
  color: #66716e;
  font-size: 22rpx;
  line-height: 1.45;
}

.picker-grid {
  display: flex;
  margin: 0 -6rpx;
}

.picker-cell {
  min-width: 0;
  flex: 1;
  margin-left: 6rpx;
  margin-right: 6rpx;
}

.save-button {
  margin-top: 24rpx;
  width: 100%;
}
