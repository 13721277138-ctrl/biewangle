.fact-grid {
  display: flex;
  margin: 22rpx -8rpx;
}

.fact-grid view {
  flex: 1;
  margin: 0 8rpx;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: #f0f5f2;
  text-align: center;
}

.fact-grid text,
.fact-grid label {
  display: block;
}

.fact-grid text {
  color: #247463;
  font-size: 40rpx;
  font-weight: 700;
}

.fact-grid label {
  margin-top: 6rpx;
  color: #64716d;
  font-size: 22rpx;
}

.backup-card {
  border-color: #abd0c5;
}

.import-card {
  border-color: #c8c3d4;
}

.import-button {
  margin-top: 20rpx;
  width: 100%;
}

.import-preview {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f3f1f8;
  color: #554f65;
  font-size: 24rpx;
  line-height: 1.7;
}

.preview-name {
  color: #3f3851;
  font-weight: 700;
}

.import-preview button {
  margin-top: 16rpx;
  width: 100%;
}

.backup-receipt {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #edf6f2;
  color: #315e53;
  font-size: 23rpx;
  line-height: 1.65;
}

.backup-receipt text {
  display: block;
}

.capability-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e8e4;
  color: #52615d;
  font-size: 25rpx;
}

.capability-row:last-child {
  border-bottom: 0;
}

.reset-card {
  border-color: #dfbbb5;
  background: #fffaf8;
}

.reset-button {
  margin-top: 20rpx;
  width: 100%;
}
