.fact-grid {
  display: flex;
  margin: 22rpx -8rpx;
}

.fact-grid view {
  flex: 1;
  margin: 0 8rpx;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: #f0f5f2;
  text-align: center;
}

.fact-grid text,
.fact-grid label {
  display: block;
}

.fact-grid text {
  color: #247463;
  font-size: 40rpx;
  font-weight: 760;
}

.fact-grid label {
  margin-top: 6rpx;
  color: #64716d;
  font-size: 22rpx;
}

.backup-card {
  border-color: #abd0c5;
}

.backup-receipt {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #edf6f2;
  color: #315e53;
  font-size: 23rpx;
  line-height: 1.65;
}

.backup-receipt text {
  display: block;
}

.capability-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e8e4;
  color: #52615d;
  font-size: 25rpx;
}

.capability-row:last-child {
  border-bottom: 0;
}
